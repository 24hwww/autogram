# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# In Docker Compose, this should match the service name
DATABASE_URL=postgresql://user:password@db:5432/autogram

# Redis Configuration
# In Docker Compose, this should match the service name
REDIS_URL=redis://redis:6379

# Instagram Configuration
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# AI Integrations (Gemini)
AI_INTEGRATIONS_GEMINI_API_KEY=your_api_key
AI_INTEGRATIONS_GEMINI_BASE_URL=your_base_url
