# Server Configuration
PORT=5000
NODE_ENV=production
TZ=America/Sao_Paulo

# Database Credentials (for Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=autogram

# Database URL (for the Application)
DATABASE_URL=postgresql://user:password@db:5432/autogram

# Redis Configuration
REDIS_URL=redis://redis:6379

# Instagram Configuration
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# AI Integrations (Gemini)
AI_INTEGRATIONS_GEMINI_API_KEY=your_api_key
AI_INTEGRATIONS_GEMINI_BASE_URL=your_base_url

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
ADMIN_2FA_SECRET=your_2fa_secret_here

# Automation Settings
AUTO_GENERATION_ENABLED=true
AUTO_GENERATION_INTERVAL_MINUTES=60
AUTO_PUBLISH_ENABLED=true

# Content Generation
CONTENT_THEMES=fitness,wellness,motivation,lifestyle
DAILY_POST_LIMIT=10

# Retry Settings
MAX_RETRY_ATTEMPTS=5
RETRY_DELAY_MINUTES=15

# AI Services
HUGGINGFACE_API_KEY=your_huggingface_key
LLAMA_API_URL=https://llama-3-8b-instruct.24hwww.workers.dev/
API_KEY=your_api_key
